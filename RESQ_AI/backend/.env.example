# RESQ AI backend environment variables. Copy this file to .env and adjust.

# Origins allowed to call the API (the frontend)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- SECURITY: change these for anything beyond a local demo ---
RESQ_SECRET_KEY=change-me-to-a-long-random-string
RESQ_DEVICE_KEY=change-me-device-key        # sensor gateways send this as header X-Device-Key
# RESQ_AUTH=off                             # disables login (local testing only)

# --- Behaviour ---
RESQ_STALE_MINUTES=120                      # sensor data older than this shows as STALE
RESQ_ESCALATE_MINUTES=2                     # unacknowledged incident escalates after this long
RESQ_CAMERA_STALE_MINUTES=10

# --- Storage ---
# RESQ_DB_PATH=/data/resqai.db              # default: <project>/database/resqai.db
# RESQ_BACKUP_DIR=/data/backups
# RESQ_BACKUP_KEEP=14
